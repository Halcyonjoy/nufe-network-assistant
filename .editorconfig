root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{xaml,csproj,props,targets,slnx}]
indent_style = space
indent_size = 2

[*.{md,yml,yaml,json,svg}]
end_of_line = lf
indent_style = space
indent_size = 2
