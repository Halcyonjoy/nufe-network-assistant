<UserControl x:Class="NufeCampus.App.SelfPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NufeCampus.App" Background="#101317" Foreground="#E8EDF2" FontFamily="Microsoft YaHei UI" FontSize="13">
 <UserControl.Resources><local:ProtectionLabelConverter x:Key="ProtectionLabel"/></UserControl.Resources>
 <Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="登录与验证" Click="ShowLoginClick" Style="{StaticResource QuietButton}" Padding="8,4"/><Button Content="退出自助登录" Click="SelfLogoutClick" Style="{StaticResource QuietButton}" Padding="8,4"/></StackPanel><StackPanel><TextBlock x:Name="SessionText" Text="尚未登录自助平台。此处状态独立于校园网认证与保活。" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,4"/><TextBlock x:Name="PrefetchText" Text="登录后自动预取全部数据页" Style="{StaticResource Caption}" FontSize="11" Margin="0"/></StackPanel></DockPanel>
  <Expander x:Name="LoginPanel" Grid.Row="1" Header="自助登录与验证 · 认证和自助共用账密" IsExpanded="True" Margin="0,4,0,14">
   <Border Style="{StaticResource Card}" Padding="16"><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><StackPanel>
    <CheckBox x:Name="SelfConsent" Checked="ConsentChanged" Unchecked="ConsentChanged" Content="我理解自助平台使用 HTTP，同意向 10.100.0.3:8080 发送自助登录及业务请求。"/>
    <WrapPanel VerticalAlignment="Center"><StackPanel Width="170"><TextBlock Text="学号"/><TextBox Style="{StaticResource DarkTextInput}" x:Name="SelfAccount" MaxLength="16" AutomationProperties.Name="自助登录学号"/></StackPanel><StackPanel Width="190" Margin="10,0"><TextBlock Text="自助密码（不回填）"/><PasswordBox Style="{StaticResource DarkPasswordInput}" x:Name="SelfPassword" MaxLength="128" AutomationProperties.Name="自助登录密码"/></StackPanel><StackPanel Width="140"><TextBlock Text="验证码（平台要求时填写）"/><TextBox Style="{StaticResource DarkTextInput}" x:Name="CaptchaCode" AutomationProperties.Name="自助验证码"/></StackPanel><TextBlock x:Name="CaptchaDecoration" Text="KSKBL" FontSize="24" FontWeight="SemiBold" Foreground="#A0ADBA" VerticalAlignment="Center" ToolTip="装饰文字，不参与认证"/><Image x:Name="CaptchaImage" Width="100" Height="38" Margin="12,0"/><Button Content="准备 / 刷新登录" Click="PrepareClick" VerticalAlignment="Center"/><Button Content="登录一次" Click="LoginClick" VerticalAlignment="Center"/></WrapPanel>
    <CheckBox x:Name="UseSaved" Content="密码留空时使用认证页保存的同一账号账密" IsChecked="True"/><CheckBox x:Name="RememberSelf" Content="登录成功后更新认证页的共用凭据，下次自动登录" IsChecked="True"/><TextBlock Text="认证与自助共用账号，不回填密码框。仅本次使用时不会保存凭据；选择加密保存后才可更新本机凭据。密码拒绝或验证码需要你处理，不会循环提交。" Style="{StaticResource Caption}"/>
   </StackPanel></ScrollViewer></Border>
  </Expander>
  <local:PageDeck x:Name="DataTabs" SelectionChanged="DataTabChanged" Grid.Row="2" Style="{StaticResource PageDeck}">
   <TabItem Header="在线设备"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Button Content="刷新在线设备" Click="DevicesClick" DockPanel.Dock="Right" Margin="0,0,0,10"/><TextBlock Text="当前账号的在线会话" FontSize="15" VerticalAlignment="Center"/></DockPanel>
    <DataGrid Style="{StaticResource DarkDataGrid}" x:Name="DevicesGrid" RowHeight="52" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTemplateColumn Header="设备 / 终端" Width="140" SortMemberPath="Host"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Host}"/><TextBlock Text="{Binding Type}" Foreground="#A0ADBA" FontSize="10"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="IP / MAC" Width="170" SortMemberPath="Ip"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Ip}"/><TextBlock Text="{Binding Mac}" Foreground="#A0ADBA" FontSize="10"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="登录时间" Binding="{Binding LoginTime}" Width="164"/><DataGridTextColumn Header="分钟" Binding="{Binding Minutes}" Width="64"/><DataGridTextColumn Header="流量 MB" Binding="{Binding FlowMb}" Width="86"/><DataGridTemplateColumn Header="保护状态" Width="96"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Foreground="#6ADBC6"><TextBlock.Text><MultiBinding Converter="{StaticResource ProtectionLabel}"><Binding Path="Mac"/><Binding Path="ProtectedMacsView" RelativeSource="{RelativeSource AncestorType={x:Type local:SelfPage}}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" Margin="0,12,0,0"><WrapPanel x:Name="DeviceActions"><Button Style="{StaticResource PrimaryButton}" Content="加入白名单" Click="OnlineWhitelistClick"/><Button Content="下线选中设备…" Foreground="#ED9B9B" Click="OfflineClick"/></WrapPanel><TextBlock Text="选中设备后操作。加入白名单立即保存，不自动启用规则；下线本机前会先持久暂停保活。" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="上网记录"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="开始" VerticalAlignment="Center"/><DatePicker x:Name="StartDate" SelectedDateChanged="FilterChanged" Width="160" Margin="8,0"/><TextBlock Text="结束" VerticalAlignment="Center"/><DatePicker x:Name="EndDate" SelectedDateChanged="FilterChanged" Width="160" Margin="8,0"/><Button Content="刷新记录" Click="HistoryClick"/><Button Content="导出筛选全部 CSV…" Click="HistoryExportClick"/></WrapPanel>
    <WrapPanel Grid.Row="1"><TextBlock x:Name="HistoryInfo" Text="默认最近 30 天；完整读取官网记录，长范围分段查询。" VerticalAlignment="Center"/><Button Content="核对官网完整记录" Click="HistoryAuditClick"/></WrapPanel>
    <DataGrid Style="{StaticResource DarkDataGrid}" x:Name="HistoryGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="上线时间" Binding="{Binding LoginTime}" Width="170"/><DataGridTextColumn Header="下线时间" Binding="{Binding LogoutTime}" Width="170"/><DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="130"/><DataGridTextColumn Header="分钟" Binding="{Binding Minutes}"/><DataGridTextColumn Header="MB" Binding="{Binding FlowMb}"/><DataGridTextColumn Header="金额 / 元" Binding="{Binding Cost}"/><DataGridTextColumn Header="国际上行 MB" Binding="{Binding InternetUp}"/><DataGridTextColumn Header="国际下行 MB" Binding="{Binding InternetDown}"/><DataGridTextColumn Header="国内上行 MB" Binding="{Binding ChinaUp}"/><DataGridTextColumn Header="国内下行 MB" Binding="{Binding ChinaDown}"/><DataGridTextColumn Header="NASIP" Binding="{Binding NasIp}" Width="130"/><DataGridTextColumn Header="NASPORT" Binding="{Binding NasPort}"/></DataGrid.Columns></DataGrid>
    <Expander Grid.Row="3" Header="筛选汇总与分向流量"><TextBlock x:Name="HistorySummary" Style="{StaticResource Caption}"/></Expander>
   </Grid></TabItem>
   <TabItem Header="账号与账单"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MinHeight="340" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="12"><StackPanel><WrapPanel><Button Content="刷新概况" Click="OverviewClick"/></WrapPanel><TextBlock x:Name="OverviewText" Text="正在加载账号概况。"/></StackPanel></Border>
    <WrapPanel Grid.Row="1"><TextBlock Text="年份" VerticalAlignment="Center"/><TextBox Style="{StaticResource DarkTextInput}" x:Name="BillYear" TextChanged="FilterChanged" Width="90" Margin="8,0"/><Button Content="刷新账单" Click="BillsClick"/><Button Content="上一页" Click="BillPrev"/><Button Content="下一页" Click="BillNext"/><Button Content="导出年度 CSV…" Click="BillExportClick"/><TextBlock x:Name="BillInfo" VerticalAlignment="Center"/></WrapPanel>
    <DataGrid Style="{StaticResource DarkDataGrid}" x:Name="BillsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="周期开始" Binding="{Binding Start}" Width="150"/><DataGridTextColumn Header="周期结束" Binding="{Binding End}" Width="150"/><DataGridTextColumn Header="套餐" Binding="{Binding Plan}" Width="*"/><DataGridTextColumn Header="月租 / 元" Binding="{Binding BaseCost}"/><DataGridTextColumn Header="计费 / 元" Binding="{Binding ExtraCost}"/><DataGridTextColumn Header="分钟" Binding="{Binding Minutes}"/><DataGridTextColumn Header="MB" Binding="{Binding FlowMb}"/><DataGridTextColumn Header="出账时间" Binding="{Binding Created}" Width="150"/></DataGrid.Columns></DataGrid>
    <TextBlock x:Name="BillSummary" Grid.Row="3" Style="{StaticResource Caption}"/>
   </Grid></ScrollViewer></TabItem>
   <TabItem Header="运营商管理"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Padding="18" Margin="0"><StackPanel>
    <DockPanel Margin="0,0,0,16"><Button Content="刷新绑定信息" Click="OperatorsClick" DockPanel.Dock="Right" Margin="0"/><StackPanel><TextBlock Text="绑定运营商账号" FontSize="18"/><TextBlock Text="三组账号统一预览，确认后提交。" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/></Grid.RowDefinitions>
     <TextBlock Grid.Column="1" Text="账号" Foreground="#A0ADBA" FontSize="12"/><TextBlock Grid.Column="3" Text="密码" Foreground="#A0ADBA" FontSize="12"/>
     <TextBlock Grid.Row="1" Text="南京移动" VerticalAlignment="Center"/><TextBox Style="{StaticResource DarkTextInput}" Grid.Row="1" Grid.Column="1" Height="36" VerticalAlignment="Center" x:Name="OperatorAccount0" MaxLength="64" AutomationProperties.Name="南京移动账号"/><PasswordBox Style="{StaticResource DarkPasswordInput}" Grid.Row="1" Grid.Column="3" Height="36" VerticalAlignment="Center" x:Name="OperatorPassword0" MaxLength="256" AutomationProperties.Name="南京移动密码"/>
     <TextBlock Grid.Row="2" Text="镇江移动" VerticalAlignment="Center"/><TextBox Style="{StaticResource DarkTextInput}" Grid.Row="2" Grid.Column="1" Height="36" VerticalAlignment="Center" x:Name="OperatorAccount1" MaxLength="64" AutomationProperties.Name="镇江移动账号"/><PasswordBox Style="{StaticResource DarkPasswordInput}" Grid.Row="2" Grid.Column="3" Height="36" VerticalAlignment="Center" x:Name="OperatorPassword1" MaxLength="256" AutomationProperties.Name="镇江移动密码"/>
     <TextBlock Grid.Row="3" Text="南京电信" VerticalAlignment="Center"/><TextBox Style="{StaticResource DarkTextInput}" Grid.Row="3" Grid.Column="1" Height="36" VerticalAlignment="Center" x:Name="OperatorAccount2" MaxLength="64" AutomationProperties.Name="南京电信账号"/><PasswordBox Style="{StaticResource DarkPasswordInput}" Grid.Row="3" Grid.Column="3" Height="36" VerticalAlignment="Center" x:Name="OperatorPassword2" MaxLength="256" AutomationProperties.Name="南京电信密码"/>
    </Grid>
    <TextBlock x:Name="OperatorText" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,8"/>
    <TextBlock Text="密码不回填、不另存。保留绑定的每行须填写正确密码；账号与密码同时留空表示解绑。镇江移动、南京电信尚未真实验收。" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,14"/>
    <Border BorderBrush="#2A323B" BorderThickness="0,1,0,0" Padding="0,14,0,0"><DockPanel><Button Content="预览变更 →" Style="{StaticResource PrimaryButton}" Click="BindClick" DockPanel.Dock="Right" MinWidth="128" Margin="0"/><CheckBox x:Name="RecoveryReady" Content="我掌握正确恢复资料，理解变更可能影响上网。" VerticalAlignment="Center" FontSize="12"/></DockPanel></Border>
   </StackPanel></Border></ScrollViewer></TabItem>
   <TabItem Header="绑定设备"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button Content="刷新绑定设备" Click="BoundClick"/><Button Content="解除选中 MAC 绑定…" Foreground="#ED9B9B" Click="RemoveMacClick"/><Button Style="{StaticResource PrimaryButton}" Content="加入白名单" Click="BoundWhitelistClick"/><Button Content="上一页" Click="BoundPrev"/><Button Content="下一页" Click="BoundNext"/></WrapPanel><DataGrid Style="{StaticResource DarkDataGrid}" x:Name="BoundGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="状态（平台原值）" Binding="{Binding State}"/><DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="160"/><DataGridTextColumn Header="终端" Binding="{Binding Terminal}" Width="*"/><DataGridTextColumn Header="最近登录" Binding="{Binding LastLogin}" Width="170"/><DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="130"/></DataGrid.Columns></DataGrid><TextBlock x:Name="BoundInfo" Grid.Row="2" Style="{StaticResource Caption}" Text="包括离线但仍绑定的设备；解除绑定与在线会话下线不同。"/></Grid></TabItem>

   <TabItem Header="业务办理记录"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><DatePicker x:Name="BusinessStart" SelectedDateChanged="BusinessFilterChanged" Width="150"/><TextBlock Text=" 至 " VerticalAlignment="Center"/><DatePicker x:Name="BusinessEnd" SelectedDateChanged="BusinessFilterChanged" Width="150"/><Button Content="刷新业务记录" Click="BusinessRefreshClick"/><Button Content="导出业务 CSV…" Click="BusinessExportClick"/></WrapPanel>
    <DataGrid Style="{StaticResource DarkDataGrid}" x:Name="BusinessGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="办理时间" Binding="{Binding Time}" Width="180"/><DataGridTextColumn Header="业务描述" Binding="{Binding Description}" Width="150"/><DataGridTextColumn Header="受理终端" Binding="{Binding Terminal}" Width="100"/><DataGridTextColumn Header="备注" Binding="{Binding Memo}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="BusinessInfo" Grid.Row="2" Style="{StaticResource Caption}"/>
   </Grid></TabItem>
   <TabItem Header="报停与复通"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="立即/预约报停、立即/预约复通及取消预约。会影响上网和计费；不会自动启动保活。真实办理尚未验收，提交前请核对具体变更。" Style="{StaticResource Caption}"/>
    <Button Content="只读刷新状态与办理记录" Click="ServiceRefreshClick" HorizontalAlignment="Left"/>
    <TextBlock Text="可办理事项以本次平台状态为准，提交前会再次核对。" Style="{StaticResource Caption}"/><Expander Header="平台状态详情" Margin="0,0,0,12"><TextBlock x:Name="ServiceStateText" Text="尚未加载" TextWrapping="Wrap" Style="{StaticResource Caption}"/></Expander>
    <WrapPanel Margin="0,10"><ComboBox x:Name="ServiceActionBox" SelectionChanged="ServiceActionChanged" Width="180"/><DatePicker x:Name="ReopenDate" Width="150"/><Button Style="{StaticResource PrimaryButton}" Content="预览业务操作…" Click="ServicePreviewClick"/></WrapPanel><TextBlock Text="日期仅用于预约复通；预约报停由平台在本周期结束后生效。" Style="{StaticResource Caption}"/>
    <TextBlock Text="报停记录" FontWeight="SemiBold"/>
    <DataGrid Style="{StaticResource DarkDataGrid}" x:Name="StopLogGrid" MaxHeight="220" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="办理时间" Binding="{Binding Time}" Width="180"/><DataGridTextColumn Header="业务" Binding="{Binding Description}"/><DataGridTextColumn Header="终端" Binding="{Binding Terminal}"/><DataGridTextColumn Header="备注" Binding="{Binding Memo}" Width="*"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="复通记录" FontWeight="SemiBold"/>
    <DataGrid Style="{StaticResource DarkDataGrid}" x:Name="ReopenLogGrid" MaxHeight="220" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="办理时间" Binding="{Binding Time}" Width="180"/><DataGridTextColumn Header="业务" Binding="{Binding Description}"/><DataGridTextColumn Header="预约日期" Binding="{Binding ScheduledDate}"/><DataGridTextColumn Header="终端" Binding="{Binding Terminal}"/><DataGridTextColumn Header="备注" Binding="{Binding Memo}" Width="*"/></DataGrid.Columns></DataGrid>
   </StackPanel></ScrollViewer></TabItem>
  </local:PageDeck>
  <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelfFeedback" Text="业务记录只保留在窗口内存；仅在你手动导出时写入所选文件。" Foreground="#A0ADBA"/><Button Grid.Column="1" Content="取消当前请求" Click="CancelClick"/></Grid>
 </Grid>
</UserControl>
