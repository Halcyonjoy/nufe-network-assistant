<Window x:Class="NufeCampus.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NufeCampus.App" ThemeMode="Dark" Icon="Assets/app.ico" Title="NUFE Campus · 校园网助手" Width="1180" Height="880" MinWidth="960" MinHeight="680" Background="#101317" Foreground="#E8EDF2" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" PreviewKeyDown="WindowKeyDown">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#14181D" BorderBrush="#2A323B" BorderThickness="0,0,1,0" Padding="15,30,15,16"><DockPanel LastChildFill="False">
   <StackPanel DockPanel.Dock="Top">
    <StackPanel Orientation="Horizontal" Margin="5,0,0,36"><Border Background="#191E24" BorderBrush="#2A323B" BorderThickness="1" CornerRadius="10" Width="36" Height="36" Margin="0,0,11,0"><Image Source="Assets/app.png" Width="36" Height="36" AutomationProperties.Name="NUFE Campus 图标"/></Border><StackPanel><TextBlock Text="NUFE" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="CAMPUS NETWORK" FontSize="9" Foreground="#A0ADBA"/></StackPanel></StackPanel>
    <TextBlock Text="工作空间" FontSize="11" Foreground="#7F8D9C" Margin="13,0,0,12"/>
    <RadioButton x:Name="OverviewNav" GroupName="MainNavigation" Tag="overview" Checked="NavigationChecked" Style="{StaticResource NavigationButton}" AutomationProperties.Name="网络概览"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}"/><TextBlock Text="网络概览"/></StackPanel></RadioButton>
    <RadioButton x:Name="KeepAliveNav" GroupName="MainNavigation" Tag="keepalive" Checked="NavigationChecked" Style="{StaticResource NavigationButton}" AutomationProperties.Name="保活记录"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}"/><TextBlock Text="保活记录"/></StackPanel></RadioButton>
    <RadioButton x:Name="DevicesNav" GroupName="MainNavigation" Tag="devices" Checked="NavigationChecked" Style="{StaticResource NavigationButton}" AutomationProperties.Name="我的设备"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE772;" Style="{StaticResource Glyph}"/><TextBlock Text="我的设备"/><TextBlock x:Name="DeviceCountBadge" Text="—" Foreground="#A0ADBA" Margin="18,0,0,0"/></StackPanel></RadioButton>
    <RadioButton x:Name="RecordsNav" GroupName="MainNavigation" Tag="records" Checked="NavigationChecked" Style="{StaticResource NavigationButton}" AutomationProperties.Name="用量与记录"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}"/><TextBlock Text="用量与记录"/></StackPanel></RadioButton>
    <RadioButton x:Name="ServicesNav" GroupName="MainNavigation" Tag="services" Checked="NavigationChecked" Style="{StaticResource NavigationButton}" AutomationProperties.Name="业务管理"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9E9;" Style="{StaticResource Glyph}"/><TextBlock Text="业务管理"/></StackPanel></RadioButton>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom">
    <RadioButton x:Name="SettingsNav" GroupName="MainNavigation" Tag="settings" Checked="NavigationChecked" Style="{StaticResource NavigationButton}" AutomationProperties.Name="设置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}"/><TextBlock Text="设置"/></StackPanel></RadioButton>
    <TextBlock Text="关闭窗口后继续保活&#x0a;（后台运行时）" Foreground="#7F8D9C" FontSize="11" Margin="10,14,0,16"/>
    <TextBlock x:Name="ModeNote" Foreground="#E7BB72" FontSize="11" Margin="8,0,0,10"/>
    <Button Content="退出程序及后台…" Click="ExitAllClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="2,0,0,12"/>
    <Border BorderBrush="#2A323B" BorderThickness="0,1,0,0" Padding="4,15,0,0"><StackPanel><TextBlock Text="当前配置账号" Foreground="#7F8D9C" FontSize="11"/><ComboBox x:Name="ProfilesBox" AutomationProperties.Name="已保存校园账号" Margin="0,6,0,6" FontSize="12"/><Button Content="切换所选账号…" Click="SelectAccountClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,4" FontSize="11" Margin="0"/></StackPanel></Border>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,24,28,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,20"><Border DockPanel.Dock="Right" BorderBrush="#2A323B" BorderThickness="1" CornerRadius="16" Padding="10,6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" FontSize="12" Width="15"/><TextBlock x:Name="NetworkNameText" Text="正在读取网络…" MaxWidth="260" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#A0ADBA"/></StackPanel></Border><StackPanel><TextBlock x:Name="PageEyebrow" Text="WORKSPACE / OVERVIEW" Foreground="#7F8D9C" FontSize="10" Margin="0,0,0,5"/><TextBlock x:Name="PageTitle" Text="网络概览" FontSize="25" FontWeight="SemiBold"/></StackPanel></DockPanel>
   <Border x:Name="SectionNavBorder" Grid.Row="1" BorderBrush="#2A323B" BorderThickness="0,0,0,1" Margin="0,0,0,18" Visibility="Collapsed"><WrapPanel x:Name="SectionNav"/></Border>
   <local:PageDeck x:Name="MainTabs" Grid.Row="2" Style="{StaticResource PageDeck}" SelectionChanged="MainTabChanged">
    <TabItem Header="网络概览"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="21" Background="#213B38" Margin="0,0,12,0"><TextBlock x:Name="ConnectionGlyph" Text="&#xE9CE;" Style="{StaticResource Glyph}" Foreground="#6ADBC6" HorizontalAlignment="Center" Width="Auto" Margin="0"/></Border><StackPanel><TextBlock x:Name="PhaseText" Text="正在查询网络状态" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionHint" Text="校园认证、外网与保活分别判断。" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></StackPanel><TextBlock x:Name="IssueText" Foreground="#E7BB72" Margin="0,8,8,0"/>
       <WrapPanel Margin="0,12,0,0"><TextBlock x:Name="AuthBadge" Text="认证 · 待查询" Margin="0,0,18,5" FontSize="12"/><TextBlock x:Name="InternetBadge" Text="外网 · 待查询" Margin="0,0,18,5" FontSize="12"/><TextBlock x:Name="KeeperBadge" Text="保活 · 待查询" Margin="0,0,18,5" FontSize="12"/><TextBlock x:Name="SelfBadge" Text="自助 · 未登录" FontSize="12"/></WrapPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="14,0,0,0"><Button x:Name="MainConnectionButton" Content="启动后台" Click="MainConnectionClick" Margin="0,0,0,6"/><Button x:Name="MoreConnectionButton" Content="更多连接操作 ⌄" Style="{StaticResource QuietButton}" Margin="0" FontSize="11" Click="MoreConnectionClick"/></StackPanel>
     </Grid>
     <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="18"><StackPanel><DockPanel Margin="0,0,0,14"><TextBlock x:Name="RateSourceText" Text="当前网络 · 最近 60 秒" DockPanel.Dock="Right" FontSize="11" Foreground="#7F8D9C"/><TextBlock Text="实时网速" FontSize="14"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="↓ 下载" Foreground="#6ADBC6" FontSize="11"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="DownloadRate" Text="—" FontSize="31"/><TextBlock x:Name="DownloadUnit" Text="MB/s" Foreground="#A0ADBA" FontSize="12" VerticalAlignment="Bottom" Margin="6,0,0,7"/></StackPanel></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="↑ 上传" Foreground="#99A2BF" FontSize="11"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="UploadRate" Text="—" FontSize="31"/><TextBlock x:Name="UploadUnit" Text="MB/s" Foreground="#A0ADBA" FontSize="12" VerticalAlignment="Bottom" Margin="6,0,0,7"/></StackPanel></StackPanel></Grid>
       <Canvas x:Name="RateChart" Height="105" Margin="0,14,0,0" ClipToBounds="True" SizeChanged="RateChartSizeChanged" AutomationProperties.Name="最近60秒当前网络接口速率曲线"/><DockPanel Margin="0,5,0,0"><TextBlock Text="现在" DockPanel.Dock="Right" FontSize="10" Foreground="#7F8D9C"/><TextBlock Text="60 秒前" FontSize="10" Foreground="#7F8D9C"/></DockPanel><TextBlock x:Name="RateText" Text="等待当前网络采样" Style="{StaticResource Caption}" FontSize="11" Margin="0,9,0,0"/>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="本次连接" FontSize="14" Margin="0,0,0,12"/><TextBlock x:Name="SessionDataText" Text="尚未读取匹配的本机自助会话，缺失字段不作推测。" FontSize="12" LineHeight="23"/><TextBlock x:Name="RecoveryText" Text="最近恢复：尚无记录" Style="{StaticResource Caption}" FontSize="11"/><Border BorderBrush="#2A323B" BorderThickness="0,1,0,0" Padding="0,10,0,0"><StackPanel><TextBlock x:Name="AccountStatusText" Text="当前认证账号：待查询" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,6"/><Button Content="联网检测与测速 ↗" Click="OpenSpeedClick" Style="{StaticResource QuietButton}" Padding="0,4" HorizontalAlignment="Left" Margin="0"/></StackPanel></Border></StackPanel></Border>
     </Grid>
     <DockPanel Margin="0,0,0,10"><Button Content="管理设备 →" Click="OpenDevicesClick" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Margin="0" Padding="0,3"/><TextBlock x:Name="OverviewDevicesTitle" Text="在线设备" FontSize="15" VerticalAlignment="Center"/></DockPanel>
     <DataGrid Style="{StaticResource DarkDataGrid}" x:Name="OverviewDevicesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="184" MinHeight="80" AutomationProperties.Name="概览在线设备"><DataGrid.Columns><DataGridTextColumn Header="设备 / 终端" Binding="{Binding Name}" Width="*" MinWidth="120"/><DataGridTextColumn Header="IP 地址" Binding="{Binding Ip}" Width="130"/><DataGridTextColumn Header="登录时间" Binding="{Binding LoginTime}" Width="175"/><DataGridTextColumn Header="保护状态" Binding="{Binding Protection}" Width="100"/></DataGrid.Columns></DataGrid>
     <TextBlock x:Name="OverviewDevicesInfo" Text="等待自助会话，未将加载失败显示为零台。" Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,0"/>
     <Border Style="{StaticResource Card}" Padding="12" Margin="0,14,0,0"><DockPanel><Button Content="管理保护规则 →" Click="OpenProtectionClick" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="0,3" Margin="0"/><TextBlock x:Name="ProtectionSummary" Text="白名单保护 · 等待配置" Foreground="#A0ADBA" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
     <Expander x:Name="ConnectionDetails" Expanded="ConnectionDetailsChanged" Collapsed="ConnectionDetailsChanged" Header="连接操作与服务器详情" IsExpanded="False" Margin="0,14,0,0"><StackPanel Margin="0,10,0,0"><TextBlock x:Name="KeeperText" Style="{StaticResource Caption}"/><TextBlock x:Name="ServerDetailText" TextWrapping="Wrap" Style="{StaticResource Caption}"/><WrapPanel><Button Content="认证并恢复保活" Click="AuthenticateResumeClick" Style="{StaticResource PrimaryButton}"/><Button Content="仅认证一次" Click="AuthenticateOnceClick"/></WrapPanel><WrapPanel x:Name="ConnectionActions"><Button Content="启动保活" Click="StartClick"/><Button Content="刷新状态" Click="RefreshClick"/><Button Content="暂停保活" Click="PauseClick"/><Button Content="恢复保活" Click="ResumeClick"/><Button Content="修复后重试" Click="RetryClick"/><Button Content="注销本机认证" Click="LogoutOnceClick"/><Button Content="本机下线并暂停…" Click="LogoutClick" Foreground="#ED9B9B"/><Button Content="手动重新认证…" Click="ReauthenticateClick"/></WrapPanel><TextBlock Text="只在 NUFE-STU 上自动认证；锁屏继续，睡眠不唤醒。已认证而外网异常时不自动下线重登。自助平台故障不影响正常保活。这是运行规则，不是实时故障结论。" Style="{StaticResource Caption}"/><WrapPanel><Button Content="打开官方自助平台" Click="OpenSelfClick"/><Button Content="打开官方认证页" Click="OpenPortalClick"/></WrapPanel></StackPanel></Expander>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="校园网账号"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border x:Name="WelcomeCard" Visibility="Collapsed" Background="#213B38" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="欢迎使用，先设置校园网账号" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="1 · 填写学号和校园网密码，选择认证运营商。&#x0a;2 · 选择是否加密保存，再点击下方按钮开始使用。" TextWrapping="Wrap" Margin="0,10,0,6"/>
      <TextBlock Text="后台保活需要加密保存账号密码，才能在关闭窗口或重启后使用。仅本次使用时，密码只留在当前窗口内存中，关闭后需要重新填写。" TextWrapping="Wrap" Foreground="#B9D6D0"/>
      <Button Content="稍后设置，先看看" Click="SkipWelcomeClick" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button Content="添加账号" Click="NewAccountClick" DockPanel.Dock="Right"/><TextBlock Text="校园网账号" FontSize="18"/></DockPanel>
      <TextBlock Text="校园认证与自助服务共用此账号。学号无需运营商后缀；密码不会回填到界面。" Style="{StaticResource Caption}"/>
      <TextBlock Text="学号"/><TextBox Style="{StaticResource DarkTextInput}" x:Name="AccountBox" MaxLength="16" AutomationProperties.Name="校园网学号"/>
      <TextBlock Text="校园网密码"/><PasswordBox Style="{StaticResource DarkPasswordInput}" x:Name="CampusPassword" MaxLength="128" AutomationProperties.Name="校园网密码"/>
      <TextBlock Text="认证运营商"/><ComboBox x:Name="CarrierBox" SelectedIndex="0"><ComboBoxItem Content="南京移动"/><ComboBoxItem Content="南京电信"/></ComboBox>
      <CheckBox x:Name="RememberCampus" Content="在本机加密保存账号密码" Checked="CredentialChoiceChanged" Unchecked="CredentialChoiceChanged" AutomationProperties.Name="在本机加密保存账号密码"/>
      <TextBlock x:Name="CredentialChoiceNote" Style="{StaticResource Caption}" Text="不勾选：仅本次使用，不保存账号密码，不能使用后台保活。"/>
      <TextBlock Text="加密保存使用当前 Windows 用户的系统保护，不提供明文保存。校方登录入口使用 HTTP，本机加密不能保护网络传输。" Style="{StaticResource Caption}"/>
      <TextBlock x:Name="CredentialNote" Style="{StaticResource Caption}"/>
      <Button x:Name="AccountApplyButton" Content="仅本次使用，开始设置" Click="SaveClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="运行偏好"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="前台信息刷新" FontSize="18"/><TextBlock Text="认证状态查询间隔（秒，1–3600）"/><TextBox x:Name="ForegroundQueryBox" Text="3" MaxLength="4" Style="{StaticResource DarkTextInput}" AutomationProperties.Name="前台认证查询间隔秒" TextChanged="ObservationInputChanged"/><TextBlock Text="外网探测间隔（秒，5–86400）"/><TextBox x:Name="ForegroundProbeBox" Text="120" MaxLength="5" Style="{StaticResource DarkTextInput}" AutomationProperties.Name="前台外网探测间隔秒" TextChanged="ObservationInputChanged"/><TextBlock Text="两个间隔独立计时，无需保存账号或启动保活。最小化暂停，恢复和切网会提前检查；网速仍每秒采样。" Style="{StaticResource Caption}"/><Button Content="应用前台刷新设置" Click="ApplyObservationClick" HorizontalAlignment="Left"/><TextBlock x:Name="ObservationNote" Text="修改后点击应用；不影响后台保活间隔。" Style="{StaticResource Caption}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="保活与启动" FontSize="18"/><CheckBox x:Name="EnableBox" Content="启用校园网认证保活" IsChecked="True"/><TextBlock Text="保活策略"/><ComboBox x:Name="StrategyBox" SelectedIndex="0" SelectionChanged="StrategyChanged" AutomationProperties.Name="保活策略"><ComboBoxItem Content="常驻后台程序"/><ComboBoxItem Content="Windows 任务计划程序"/></ComboBox><TextBlock Text="检查间隔（秒）"/><TextBox x:Name="CheckIntervalBox" Text="30" MaxLength="5" Style="{StaticResource DarkTextInput}" AutomationProperties.Name="保活检查间隔秒"/><TextBlock x:Name="StrategyNote" Style="{StaticResource Caption}"/><CheckBox x:Name="AutoStartBox" Content="常驻后台：登录 Windows 后启动" IsChecked="True"/><TextBlock Text="任务计划需要加密保存并启用保活；仅在当前用户登录期间运行。两种策略互斥，切换时停止原策略。" Style="{StaticResource Caption}"/><TextBlock Text="计划任务名称（留空使用原默认名称）"/><TextBox x:Name="TaskNameBox" MaxLength="128" Style="{StaticResource DarkTextInput}" AutomationProperties.Name="计划任务名称" TextChanged="TaskNameChanged"/><Button Content="应用计划名称" Click="ApplyTaskNameClick" HorizontalAlignment="Left"/><TextBlock x:Name="TaskNameNote" Text="名称独立应用，无需填写账号；已有任务将迁移，未注册任务时仅保存名称。名称只保存在本机，不随偏好备份导出。" Style="{StaticResource Caption}"/><TextBlock x:Name="TaskNote" Style="{StaticResource Caption}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="校方入口传输说明" FontSize="16"/><TextBlock Text="校方入口使用 HTTP，本机加密不能保护密码在校方网络中的传输。校园认证只向 10.200.253.5 发送，不将凭据跳转至其他服务器。" Style="{StaticResource Caption}"/><CheckBox x:Name="HttpConsent" Content="我理解上述传输限制，同意向校方认证入口发送凭据。"/></StackPanel></Border><WrapPanel><Button Content="停止保活运行" Click="StopClick"/><Button Content="移除自启动与本机数据…" Click="RemoveClick" Foreground="#ED9B9B"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="诊断与备份"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="手动备份" FontSize="18"/><TextBlock Text="备份仅含偏好，不含账号密码、登录会话和令牌。重装或换电脑后需重新输入凭据。" Style="{StaticResource Caption}"/><WrapPanel><Button Content="导出配置备份" Click="BackupClick"/><Button Content="导入配置备份" Click="ImportClick"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="诊断日志" FontSize="18"/><TextBlock Text="只记录时间和固定事件码，不记录账号、IP、MAC、密码或服务器原文。保留最近 7 天，总量不超过 10 MB。诊断导出不含凭据。" Style="{StaticResource Caption}"/><Button Content="导出脱敏诊断" Click="DiagnosticClick" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="SelfTab" Header="自助数据"><ContentControl x:Name="SelfHost"/></TabItem>
    <TabItem Header="白名单保护"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="超限时，保留这些设备" FontSize="20"/><TextBlock Text="规则仅属于当前配置账号。只有本机认证遇到设备数超限才处理名单外设备，不持续清理。" Style="{StaticResource Caption}"/><TextBlock Text="保留的 MAC（每行一个）"/><TextBox Style="{StaticResource DarkTextInput}" x:Name="ProtectedMacsBox" AcceptsReturn="True" MinHeight="110" MaxLength="4096" AutomationProperties.Name="保留设备白名单"/><TextBlock Text="也可从在线设备或绑定设备直接加入；随机 MAC 变化后需更新名单。" Style="{StaticResource Caption}"/><CheckBox x:Name="AutoOfflineBox" Content="启用白名单保护与超限自动处理"/><ComboBox x:Name="OfflineOrderBox" SelectedIndex="0"><ComboBoxItem Content="优先下线登录最早的名单外设备"/><ComboBoxItem Content="优先下线登录最近的名单外设备"/><ComboBoxItem Content="通知我手动选择"/></ComboBox><CheckBox x:Name="SelfPermissionBox" Content="允许后台向 10.100.0.3:8080 HTTP 自助平台发送所选账号凭据，仅在超限时按需处理。"/><TextBlock Text="空名单不能启用；本机永不自动下线，每轮最多一台。密码拒绝、验证码、无候选或目标重连时停止处理，冲突后须手动恢复。校园认证独立运行。" Style="{StaticResource Caption}"/><Button Content="手动恢复已停用的自动规则" Click="RecoverAutoClick" HorizontalAlignment="Left"/></StackPanel></Border></ScrollViewer></TabItem>
    <TabItem Header="联网与测速"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="联网检测与主动测速" FontSize="20"/><TextBlock Text="实时网速无需启动测速；主动测速由你点击后运行，可随时取消。" Style="{StaticResource Caption}"/><ComboBox x:Name="NetworkPathBox" SelectedIndex="0"><ComboBoxItem Content="正常网络路径（系统代理设置）"/><ComboBoxItem Content="校园网源地址绑定（VPN 绕过未确认）"/></ComboBox><ComboBox x:Name="SpeedModeBox" SelectedIndex="0"><ComboBoxItem Content="快速 · 最长 30 秒 / 总预算 200 MB（有效载荷最多 160 MB）"/><ComboBoxItem Content="充分 · 最长 60 秒 / 总预算 1 GB（有效载荷最多 600 MB）"/></ComboBox><TextBlock Text="轻量检测使用微软公共连通性服务。测速向 Cloudflare 发送合成数据，不发送校园账号密码；结果可能受 VPN 和其他下载影响。不会更改系统代理、VPN 或路由。" Style="{StaticResource Caption}"/><WrapPanel><Button Content="检测能否上网" Click="CheckInternetClick"/><Button Content="开始测速" Click="SpeedClick" Style="{StaticResource PrimaryButton}"/><Button Content="取消测速" Click="CancelSpeedClick"/></WrapPanel><TextBlock x:Name="NetworkResultText" Text="尚未检测" Style="{StaticResource Caption}"/><TextBlock x:Name="SpeedResultText" Text="尚未测速" Style="{StaticResource Caption}"/><CheckBox x:Name="MbpsBox" Content="实时速率使用 Mbps（默认 MB/s）"/></StackPanel></Border></ScrollViewer></TabItem>
    <TabItem x:Name="KeepAliveHistoryTab" Header="保活记录"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Content="刷新保活记录" Click="RefreshHistoryClick" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel><TextBlock Text="每次后台执行，做了什么、结果如何" FontSize="18"/><TextBlock Text="支持常驻后台与计划任务；仅保存时间和操作结果，不保存账号、密码、IP、MAC 或服务器原文。记录从此版本开始，保留最近 7 天且最多 5 MB，列表展示最近 300 次。" Style="{StaticResource Caption}"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="KeepAliveHistoryGrid" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="HistorySelectionChanged" AutomationProperties.Name="后台保活执行记录"><DataGrid.Columns><DataGridTextColumn Header="开始时间" Binding="{Binding Time}" Width="125"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="150"/><DataGridTextColumn Header="检查情况" Binding="{Binding Observation}" Width="145"/><DataGridTextColumn Header="处理结果" Binding="{Binding Result}" Width="*" MinWidth="145"/><DataGridTextColumn Header="耗时" Binding="{Binding Duration}" Width="85"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" x:Name="KeepAliveHistoryNote" Text="选择记录查看执行过程。" Style="{StaticResource Caption}"/><Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0" VerticalAlignment="Stretch"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="KeepAliveHistoryDetails" Text="选择一条记录查看执行过程。" TextWrapping="Wrap" LineHeight="23"/></ScrollViewer></Border></Grid></TabItem>
    <TabItem x:Name="UpdateTab" Header="软件更新"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="软件更新" FontSize="20"/><TextBlock x:Name="CurrentVersionText" Style="{StaticResource Caption}"/><TextBlock Text="从本项目 GitHub Release 获取最新正式版，下载并核对 SHA256 后打开安装程序。更新保留账号配置与保活策略，不向 GitHub 发送校园网账号或密码。" Style="{StaticResource Caption}"/><WrapPanel><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdateClick"/><Button x:Name="InstallUpdateButton" Content="下载并安装更新" Click="InstallUpdateClick" IsEnabled="False" Style="{StaticResource PrimaryButton}"/><Button x:Name="CancelUpdateButton" Content="取消" Click="CancelUpdateClick" IsEnabled="False"/><Button Content="打开 Release 页面" Click="OpenReleaseClick"/></WrapPanel><ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6" Visibility="Collapsed" Margin="0,12,0,12"/><TextBlock x:Name="UpdateStatus" Text="点击检查更新，获取可用版本。" Style="{StaticResource Caption}"/><TextBlock Text="安装结束后自动清理安装包和更新临时文件；异常中断的残留会在后续启动时清理。" Style="{StaticResource Caption}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="版本说明" FontSize="16"/><TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" Style="{StaticResource Caption}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
